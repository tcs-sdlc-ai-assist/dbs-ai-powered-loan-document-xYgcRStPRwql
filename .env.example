# =============================================================================
# DBS Loan Verification Portal - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# Do NOT commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/dbs_loan_verification?schema=public"

# -----------------------------------------------------------------------------
# NextAuth.js
# -----------------------------------------------------------------------------
# The canonical URL of your site (used for callbacks and redirects)
NEXTAUTH_URL="http://localhost:3000"

# A random secret used to encrypt tokens and sign cookies
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-here"

# -----------------------------------------------------------------------------
# AI Service (Mock)
# -----------------------------------------------------------------------------
# API key for the AI verification service
AI_API_KEY="mock-ai-api-key"

# Base URL for the AI verification service endpoint
AI_API_URL="http://localhost:3000/api/mock/ai"

# -----------------------------------------------------------------------------
# File Upload
# -----------------------------------------------------------------------------
# Maximum upload file size in megabytes
UPLOAD_MAX_SIZE_MB="10"

# Comma-separated list of allowed MIME types for document uploads
ALLOWED_FILE_TYPES="application/pdf,image/png,image/jpeg"

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# Log level: debug | info | warn | error
LOG_LEVEL="info"